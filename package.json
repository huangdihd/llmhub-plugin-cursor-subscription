{
  "name": "llmhub-plugin-cursor-subscription",
  "version": "0.1.0",
  "description": "Use a Cursor subscription as an LLMHub provider through the official Cursor Agent CLI.",
  "type": "module",
  "main": "index.mjs",
  "files": ["index.mjs", "lib", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check index.mjs && node --check lib/bridge.mjs && node --check lib/codec.mjs && node --check lib/worker.mjs && node --check lib/history.mjs && node --check lib/supervision.mjs"
  },
  "keywords": ["llmhub-plugin", "llmhub", "cursor", "cursor-agent", "provider"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huangdihd/llmhub-plugin-cursor-subscription.git"
  },
  "homepage": "https://github.com/huangdihd/llmhub-plugin-cursor-subscription#readme",
  "bugs": { "url": "https://github.com/huangdihd/llmhub-plugin-cursor-subscription/issues" },
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": { "node": ">=18.2", "llmhub": "^1.5.0" },
  "os": ["darwin", "linux"],
  "dependencies": {
    "cursor-api-proxy": "1.7.0"
  },
  "llmhub": {
    "id": "cursor-subscription",
    "name": "Cursor Subscription",
    "configSchema": [
      { "key": "agent_binary", "label": "Cursor CLI executable (empty: discover on PATH)", "type": "text", "default": "" },
      { "key": "cursor_api_key", "label": "Cursor API key (empty: existing CLI login)", "type": "secret" },
      { "key": "bridge_port", "label": "Private bridge port (0: automatic)", "type": "number", "default": 0 },
      { "key": "enable_tools", "label": "Experimental ACP tool calls (requires compatible CLI)", "type": "boolean", "default": false },
      { "key": "timeout_seconds", "label": "Request deadline in seconds", "type": "number", "default": 180 }
    ]
  }
}
